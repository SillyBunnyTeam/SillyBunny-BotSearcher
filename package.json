{
    "name": "sillybunny-botsearcher",
    "version": "0.7.0",
    "description": "Server plugin required by the SillyBunny BotSearcher frontend extension.",
    "type": "module",
    "main": "server/index.js",
    "private": true,
    "scripts": {
        "lint": "eslint .",
        "test": "node --test tests/*.test.js",
        "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
        "probe": "node scripts/probe-sources.mjs"
    },
    "dependencies": {
        "node-fetch": "^3.3.2",
        "playwright": "^1.62.1",
        "rate-limiter-flexible": "^11.2.0"
    },
    "devDependencies": {
        "eslint": "^9.39.5",
        "express": "^5.2.1",
        "jsdom": "^26.1.0"
    },
    "license": "AGPL-3.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/SillyBunnyTeam/SillyBunny-BotSearcher.git"
    },
    "sillybunny": {
        "serverPlugin": {
            "id": "sillybunny-botsearcher",
            "preservePaths": [
                ".cursor-key",
                ".sillybunny-janny-profile"
            ]
        }
    },
    "engines": {
        "node": ">=22 <27"
    }
}
